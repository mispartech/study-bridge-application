# Copy to .env.local and fill in. Never commit .env.local.

# Dashboard → Project Settings → API (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://vtintwtuyauwgabcnayu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard → Project Settings → API → service_role / secret key (server only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard → Connect → "Session pooler" URI, with your database password filled in
SUPABASE_DB_URL=

# Show is_demo records (the 30 fake programmes) in matching. Never true in production.
NEXT_PUBLIC_DEMO_MODE=

# AI providers. Only the providers named in config/ai.json need a key.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Ingestion: contact email sent in the crawler's User-Agent (docs/EXTRACTION.md section 5)
INGEST_CONTACT_EMAIL=

# /admin pages (HTTP Basic). Leave empty to disable admin pages entirely.
ADMIN_USER=
ADMIN_PASSWORD=

# Ingestion service API (POST /runs needs "Authorization: Bearer <token>")
INGEST_API_TOKEN=
