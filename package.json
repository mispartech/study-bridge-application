{
  "name": "study-bridge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:advisor:retest": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.eval.config.mts --mode retest",
    "eval:advisor": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.eval.config.mts",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:migrate": "node --env-file=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file=.env.local scripts/db.mjs seed",
    "db:status": "node --env-file=.env.local scripts/db.mjs status",
    "db:types": "node --env-file=.env.local scripts/db-types.mjs",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.db.config.mts",
    "secret:scan": "node --env-file-if-exists=.env.local scripts/secret-scan.mjs",
    "match:fixture": "node --env-file=.env.local scripts/export-demo-catalogue.mjs",
    "test:ingest": "uv run --project ingest python -m pytest ingest/tests -q",
    "ingest:golden:fetch": "uv run --project ingest python -m ingest.golden.fetch",
    "ingest:golden": "uv run --project ingest python -m ingest.golden.run",
    "ai:compare": "uv run --project ingest python -m ingest.golden.run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.83",
    "@ai-sdk/google": "4.0.100",
    "@ai-sdk/openai": "4.0.97",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.145",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "framer-motion": "14.4.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "lighthouse": "13.5.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
