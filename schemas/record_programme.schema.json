{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "found",
    "university",
    "programme",
    "requirement",
    "intakes",
    "fees",
    "scholarships",
    "confidence",
    "missing_fields",
    "source_urls"
  ],
  "properties": {
    "found": {
      "type": "boolean"
    },
    "university": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "country",
        "city",
        "official_domain"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "country": {
          "enum": [
            "UK",
            "CA",
            "US"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "official_domain": {
          "type": "string",
          "description": "e.g. manchester.ac.uk"
        }
      }
    },
    "programme": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "title",
        "degree_type",
        "field",
        "duration_months",
        "study_mode",
        "programme_url",
        "apply_url"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "degree_type": {
          "enum": [
            "MSc",
            "MA",
            "MEng",
            "MBA",
            "MRes",
            "MPH",
            "LLM",
            "MPS",
            "Other"
          ]
        },
        "field": {
          "enum": [
            "computer_data_science",
            "public_health",
            "business_finance",
            "engineering",
            "project_management",
            "law",
            "nursing",
            "mental_health",
            "other"
          ]
        },
        "duration_months": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 6,
          "maximum": 36
        },
        "study_mode": {
          "enum": [
            "full_time",
            "part_time",
            "online",
            "blended",
            null
          ]
        },
        "stem_designated": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "US only: page states STEM / CIP STEM-designated"
        },
        "has_coop_or_placement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1200
        },
        "programme_url": {
          "type": "string"
        },
        "apply_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "requirement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "academic_rule_text",
        "min_uk_class",
        "min_gpa4",
        "nigeria_rule",
        "english_tests",
        "english_waiver_text",
        "gre_required",
        "gmat_required",
        "min_work_years",
        "documents"
      ],
      "properties": {
        "academic_rule_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "min_uk_class": {
          "enum": [
            "first",
            "upper_second",
            "lower_second",
            "third",
            "pass",
            null
          ]
        },
        "min_gpa4": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "considers_lower_with_experience": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "nigeria_rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "english_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test",
              "overall_min"
            ],
            "properties": {
              "test": {
                "enum": [
                  "IELTS",
                  "TOEFL_iBT",
                  "PTE",
                  "Duolingo",
                  "Cambridge",
                  "Other"
                ]
              },
              "scale": {
                "enum": [
                  "0-120",
                  "1-6",
                  null
                ],
                "description": "TOEFL iBT only"
              },
              "overall_min": {
                "type": "number"
              },
              "subscore_min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "english_waiver_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "waec_english_accepted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "waec_min_grade": {
          "enum": [
            "A1",
            "B2",
            "B3",
            "C4",
            "C5",
            "C6",
            "D7",
            "E8",
            "F9",
            null
          ]
        },
        "gre_required": {
          "enum": [
            "required",
            "optional",
            "not_required",
            "one_of_required",
            null
          ]
        },
        "gmat_required": {
          "enum": [
            "required",
            "optional",
            "not_required",
            "one_of_required",
            null
          ]
        },
        "min_work_years": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "documents": {
          "type": "array",
          "items": {
            "enum": [
              "sop",
              "references",
              "cv",
              "transcript",
              "portfolio",
              "writing_sample",
              "interview",
              "other"
            ]
          }
        },
        "requires_professional_registration": {
          "enum": [
            "none",
            "nurse",
            "other",
            null
          ]
        },
        "leads_to_registration": {
          "type": [
            "string",
            "null"
          ]
        },
        "clinical_placement": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "open_to_international": {
          "enum": [
            "yes",
            "limited",
            "no",
            null
          ]
        },
        "checks_required": {
          "type": "array",
          "items": {
            "enum": [
              "police",
              "health",
              "immunisation"
            ]
          }
        }
      }
    },
    "intakes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_term",
          "start_month",
          "deadlines"
        ],
        "properties": {
          "start_term": {
            "enum": [
              "fall",
              "winter",
              "spring",
              "summer"
            ]
          },
          "start_month": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "null when the pages give only a term"
          },
          "application_opens": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "deadlines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "date",
                "date_precision"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "date_precision": {
                  "enum": [
                    "day",
                    "month"
                  ]
                }
              }
            }
          },
          "deposit_amount": {
            "type": [
              "number",
              "null"
            ]
          },
          "deposit_currency": {
            "enum": [
              "GBP",
              "CAD",
              "USD",
              null
            ]
          },
          "deposit_deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fee_year",
          "tuition_amount",
          "currency",
          "basis"
        ],
        "properties": {
          "fee_year": {
            "type": [
              "string",
              "null"
            ],
            "description": "academic year as YYYY/YY, e.g. 2027/28; null when not printed"
          },
          "tuition_amount": {
            "type": "number",
            "minimum": 0
          },
          "currency": {
            "enum": [
              "GBP",
              "CAD",
              "USD"
            ]
          },
          "basis": {
            "enum": [
              "per_year",
              "total",
              "per_credit",
              "per_term"
            ]
          },
          "credits_total": {
            "type": [
              "number",
              "null"
            ]
          },
          "application_fee": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "scholarships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "amount": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "enum": [
              "GBP",
              "CAD",
              "USD",
              null
            ]
          },
          "coverage_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "eligibility_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programme",
        "requirement",
        "intakes",
        "fees",
        "scholarships"
      ],
      "properties": {
        "programme": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requirement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "intakes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fees": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scholarships": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
